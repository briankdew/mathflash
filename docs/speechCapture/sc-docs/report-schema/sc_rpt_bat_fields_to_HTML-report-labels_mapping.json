{"upload_p90_ms": "90th percentile audio chunk upload latency"} >> {"audio_upload_latency_p90_ms": "90th percentile audio chunk upload latency"}

{"upload_max_ms": "maximum audio chunk upload latency"} >> {"audio_upload_latency_max_ms": "maximum audio chunk upload latency"}

